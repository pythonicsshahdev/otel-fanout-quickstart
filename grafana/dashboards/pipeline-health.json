{
  "title": "Pipeline Health",
  "uid": "pipeline-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["otel", "pipeline"],
  "panels": [
    {
      "type": "row",
      "title": "Ingestion",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Logs Received",
      "id": 2,
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelcol_receiver_accepted_log_records_total)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Metric Points Received",
      "id": 3,
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelcol_receiver_accepted_metric_points_total)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Spans Received",
      "id": 4,
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelcol_receiver_accepted_spans_total)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Export Errors",
      "id": 5,
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelcol_exporter_send_failed_log_records_total + otelcol_exporter_send_failed_spans_total + otelcol_exporter_send_failed_metric_points_total) or vector(0)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Rate",
      "id": 6,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_receiver_accepted_log_records_total[1m])",
          "legendFormat": "Logs/s"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_receiver_accepted_metric_points_total[1m])",
          "legendFormat": "Metric points/s"
        },
        {
          "refId": "C",
          "expr": "rate(otelcol_receiver_accepted_spans_total[1m])",
          "legendFormat": "Spans/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Exporters",
      "id": 7,
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Export Rate by Exporter",
      "id": 8,
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_exporter_sent_log_records_total[1m])",
          "legendFormat": "Logs → {{exporter}}"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_exporter_sent_spans_total[1m])",
          "legendFormat": "Spans → {{exporter}}"
        },
        {
          "refId": "C",
          "expr": "rate(otelcol_exporter_sent_metric_points_total[1m])",
          "legendFormat": "Metrics → {{exporter}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Export Failures by Exporter",
      "id": 9,
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_exporter_send_failed_log_records_total[1m])",
          "legendFormat": "Logs failed → {{exporter}}"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_exporter_send_failed_spans_total[1m])",
          "legendFormat": "Spans failed → {{exporter}}"
        },
        {
          "refId": "C",
          "expr": "rate(otelcol_exporter_send_failed_metric_points_total[1m])",
          "legendFormat": "Metrics failed → {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Exporter Queue Size",
      "id": 10,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "otel-collector-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "{{exporter}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    }
  ]
}
