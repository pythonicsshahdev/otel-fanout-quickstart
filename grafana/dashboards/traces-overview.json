{
  "title": "Traces Overview",
  "uid": "traces-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "tags": ["otel", "traces"],
  "panels": [
    {
      "type": "stat",
      "title": "Total Spans",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "1d", "min_doc_count": "0" } }],
          "timeField": "startTime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Error Spans",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "status.code:Error",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "1d", "min_doc_count": "0" } }],
          "timeField": "startTime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unique Processes",
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "cardinality", "field": "attributes.process.name.keyword" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "1d", "min_doc_count": "0" } }],
          "timeField": "startTime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Avg Span Duration",
      "id": 4,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "avg", "field": "durationInNanos" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "1d", "min_doc_count": "0" } }],
          "timeField": "startTime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "ns" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Span Rate Over Time",
      "id": 5,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "alias": "All Spans",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "auto", "min_doc_count": "0" } }],
          "timeField": "startTime"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "status.code:Error",
          "alias": "Error Spans",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "startTime", "settings": { "interval": "auto", "min_doc_count": "0" } }],
          "timeField": "startTime"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Error Spans" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "barchart",
      "title": "Top Processes by Span Count",
      "id": 6,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "terms", "id": "2", "field": "attributes.process.name.keyword", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "10" } }],
          "timeField": "startTime"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "xTickLabelRotation": -45, "tooltip": { "mode": "single" } }
    },
    {
      "type": "piechart",
      "title": "Span Status Distribution",
      "id": 7,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [{ "type": "terms", "id": "2", "field": "status.code.keyword", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "5" } }],
          "timeField": "startTime"
        }
      ],
      "options": { "pieType": "donut", "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Recent Spans",
      "id": 8,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-traces" },
          "query": "",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            { "type": "terms", "id": "2", "field": "name.keyword", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "1", "size": "20" } }
          ],
          "timeField": "startTime"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "sortBy": [{ "displayName": "Count", "desc": true }] }
    }
  ]
}
