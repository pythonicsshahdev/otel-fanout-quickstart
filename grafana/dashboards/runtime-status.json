{
  "title": "Runtime Status",
  "uid": "runtime-status",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["otel", "boomi", "runtime"],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
        "query": "{\"find\": \"terms\", \"field\": \"tags.runtime.name.keyword\"}",
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Low Memory Mode",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
        "query": "name:runtime.isLowMemoryMode AND tags.runtime.name:$node",
        "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
        "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "1m", "min_doc_count": "1" } }],
        "timeField": "timestamp"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "orientation": "auto" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "Normal", "color": "green" }, "1": { "text": "LOW MEMORY", "color": "red" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Out of Memory Error",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
        "query": "name:runtime.isOutOfMemoryError AND tags.runtime.name:$node",
        "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
        "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "1m", "min_doc_count": "1" } }],
        "timeField": "timestamp"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "OOM ERROR", "color": "red" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Restarting",
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
        "query": "name:runtime.isRestarting AND tags.runtime.name:$node",
        "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
        "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "1m", "min_doc_count": "1" } }],
        "timeField": "timestamp"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "Running", "color": "green" }, "1": { "text": "RESTARTING", "color": "orange" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Scheduled Processes",
      "id": 4,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
        "query": "name:runtime.scheduleCount AND tags.runtime.name:$node",
        "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
        "bucketAggs": [{ "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "1m", "min_doc_count": "1" } }],
        "timeField": "timestamp"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Platform Messaging — Upload",
      "id": 5,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:runtime.platformMessaging.uploadDeliveredCount AND tags.runtime.name:$node",
          "alias": "Delivered",
          "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:runtime.platformMessaging.uploadFailureCount AND tags.runtime.name:$node",
          "alias": "Failures",
          "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "C",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:runtime.platformMessaging.uploadPendingCount AND tags.runtime.name:$node",
          "alias": "Pending",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Failures.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Pending.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Platform Messaging — Download",
      "id": 6,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:runtime.platformMessaging.downloadDeliveredCount AND tags.runtime.name:$node",
          "alias": "Delivered",
          "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:runtime.platformMessaging.downloadFailureCount AND tags.runtime.name:$node",
          "alias": "Failures",
          "metrics": [{ "id": "1", "type": "max", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Failures.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Queue Server Memory & Disk",
      "id": 7,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:plugin.queueServer.memory AND tags.runtime.name:$node",
          "alias": "Memory Used",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:plugin.queueServer.diskUsage AND tags.runtime.name:$node",
          "alias": "Disk Used",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "C",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:plugin.queueServer.config.maxMemory AND tags.runtime.name:$node",
          "alias": "Max Memory",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Max Memory.*" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 8] } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Queue Server Count & Threads",
      "id": 8,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:plugin.queueServer.count AND tags.runtime.name:$node",
          "alias": "Queue Count",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-metrics" },
          "query": "name:plugin.queueServer.config.maxThreads AND tags.runtime.name:$node",
          "alias": "Max Threads",
          "metrics": [{ "id": "1", "type": "avg", "field": "gauge.value" }],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "tags.runtime.name.keyword", "settings": { "size": "10", "order": "desc", "orderBy": "1", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "timeField": "timestamp"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    }
  ]
}
