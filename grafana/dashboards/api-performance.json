{
  "title": "API Performance",
  "uid": "api-performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "otel",
    "traces",
    "api"
  ],
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "label": "Endpoint",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "opensearch-traces"
        },
        "query": "{\"find\":\"terms\",\"field\":\"attributes.http.route.keyword\",\"size\":50}",
        "refresh": 2,
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "API Requests",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "attributes.http.request.method:(GET OR POST OR PUT OR DELETE OR PATCH) AND attributes.http.route:$route",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "1d",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "startTime"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Distinct Endpoints",
