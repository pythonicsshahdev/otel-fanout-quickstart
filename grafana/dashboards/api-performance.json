    {
      "type": "stat",
      "title": "Error Responses (logged)",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "_exists_:attributes.responseCode AND NOT attributes.responseCode:0",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "1d",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "startTime"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Boomi marks every API root span status Ok, so span status cannot detect failures. This counts spans whose logger reported a non-zero responseCode."
    },
