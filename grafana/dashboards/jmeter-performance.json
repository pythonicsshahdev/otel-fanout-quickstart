{
  "uid": "boomi-perf-jmeter",
  "title": "Boomi Performance Tests (JMeter)",
  "tags": [
    "boomi",
    "performance",
    "jmeter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Client-side load-test metrics from JMeter. Pick one run_id, or several to overlay runs.",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "otel-collector-prom"
        },
        "query": {
          "query": "label_values(jmeter_requests_total, run_id)",
          "refId": "runs"
        },
        "definition": "label_values(jmeter_requests_total, run_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jmeter_requests_total{run_id=~\"$run_id\"}[30s]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jmeter_failures_total{run_id=~\"$run_id\"}[30s])) / sum(rate(jmeter_requests_total{run_id=~\"$run_id\"}[30s]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 response time (worst sampler)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(jmeter_response_time_ms{quantile=\"0.99\", run_id=~\"$run_id\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total requests (selected runs)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(jmeter_requests_total{run_id=~\"$run_id\"}[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput by sampler",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (rate(jmeter_requests_total{run_id=~\"$run_id\"}[30s]))",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time p50 / p90 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jmeter_response_time_ms{run_id=~\"$run_id\"}",
          "legendFormat": "{{label}} q={{quantile}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors by HTTP code",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label, code) (rate(jmeter_failures_total{run_id=~\"$run_id\"}[30s]))",
          "legendFormat": "{{label}} {{code}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Run-over-run: p99 by run_id",
      "description": "One line per run. Select several runs in the Run dropdown to overlay them.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "otel-collector-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (run_id) (jmeter_response_time_ms{quantile=\"0.99\", run_id=~\"$run_id\"})",
          "legendFormat": "{{run_id}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Where the time goes: client vs runtime vs process (avg ms)",
      "description": "Blue = what JMeter measured. Runtime HTTP span = the Boomi runtime's own timing of the same request. Process execution = just the process. Gap between the last two = runtime overhead outside the process (startup, logging, document handling). Boomi listener tests only.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "otel-collector-prom"
          },
          "legendFormat": "JMeter (client)",
          "expr": "sum(rate(jmeter_response_time_ms_sum{label=~\"Boomi.*\",run_id=~\"$run_id\"}[30s])) / sum(rate(jmeter_response_time_ms_count{label=~\"Boomi.*\",run_id=~\"$run_id\"}[30s]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "attributes.http.route:*otelperf* AND attributes.http.request.method:POST",
          "alias": "Runtime HTTP span",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "attributes.duration_ms"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "startTime"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "name:\"Execute process\" AND attributes.process.name.keyword:\\(API\\)perf*",
          "alias": "Process execution span",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "attributes.duration_ms"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "startTime"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Runtime HTTP span: p50 / p95 / p99 (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "attributes.http.route:*otelperf* AND attributes.http.request.method:POST",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "attributes.duration_ms",
              "settings": {
                "percents": [
                  "50",
                  "95",
                  "99"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "startTime"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Runtime HTTP requests per interval (all otelperf routes)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "query": "attributes.http.route:*otelperf*",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "attributes.http.route.keyword",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "startTime",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "startTime"
        }
      ]
    }
  ]
}