receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  # Boomi spans carry no duration field, and send the processStep document
  # counts/sizes as strings. Promote both to numbers so OpenSearch can
  # aggregate them (latency percentiles, throughput sums).
  transform/boomi_numeric:
    error_mode: ignore
    trace_statements:
      - context: span
        statements:
          - set(span.attributes["duration_ms"], (span.end_time_unix_nano - span.start_time_unix_nano) / 1000000.0)
          - set(span.attributes["processStep.inboundDocumentCount"], Int(span.attributes["processStep.inboundDocumentCount"])) where span.attributes["processStep.inboundDocumentCount"] != nil
          - set(span.attributes["processStep.outboundDocumentCount"], Int(span.attributes["processStep.outboundDocumentCount"])) where span.attributes["processStep.outboundDocumentCount"] != nil
          - set(span.attributes["processStep.inboundDocumentSize"], Int(span.attributes["processStep.inboundDocumentSize"])) where span.attributes["processStep.inboundDocumentSize"] != nil
          - set(span.attributes["processStep.outboundDocumentSize"], Int(span.attributes["processStep.outboundDocumentSize"])) where span.attributes["processStep.outboundDocumentSize"] != nil
  # Boomi's instrumentation cannot attach custom HTTP headers to a span, so the
  # USF processes pass business dimensions (consumerId, responseCode, ...) as
  # ' | key=value | ' pairs inside Notify shape messages. Promote them to real
  # span attributes so Grafana can group and filter on them.
  # Caveat: values that themselves contain '|' (e.g. the cache key
  # 'key=42|productprice|v1') cannot be extracted this way and are left alone.
  transform/boomi_usf_fields:
    error_mode: ignore
    trace_statements:
      - context: span
        conditions:
          - span.attributes["userEvent.message"] != nil
        statements:
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*consumerId=[ ]*(?P<consumerId>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*subConsumerId=[ ]*(?P<subConsumerId>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*correlationId=[ ]*(?P<correlationId>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*transactionId=[ ]*(?P<transactionId>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*txn=[ ]*(?P<txn>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*responseCode=[ ]*(?P<responseCode>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*httpStatus=[ ]*(?P<httpStatus>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*endPoint=[ ]*(?P<endPoint>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*scenario=[ ]*(?P<scenario>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*divisionNbr=[ ]*(?P<divisionNbr>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          - merge_maps(span.attributes, ExtractPatterns(span.attributes["userEvent.message"], "[|][ ]*priced=[ ]*(?P<priced>[^|]*?)[ ]*(?:[|]|$)"), "upsert")
          # 'priced' is a measure, not a dimension — make it summable.
          - set(span.attributes["priced"], Int(span.attributes["priced"])) where span.attributes["priced"] != nil
  batch:
    timeout: 10s
    send_batch_size: 1024

exporters:
  opensearch/traces:
    http:
      endpoint: "{{consumers.opensearch.endpoint}}"
      timeout: 30s
    logs_index: boomi-traces
    sending_queue:
      enabled: true
{{#if consumers.splunk.enabled}}
  splunk_hec/splunk:
    token: "{{consumers.splunk.token}}"
    endpoint: "{{consumers.splunk.endpoint}}"
    source: boomi
    sourcetype: _json
{{/if}}
{{#if consumers.newrelic.enabled}}
  otlp/newrelic:
    endpoint: https://otlp.nr-data.net:4317
    headers:
      api-key: "{{consumers.newrelic.license_key}}"
{{/if}}
{{#if consumers.datadog.enabled}}
  datadog/datadog:
    api:
      key: "{{consumers.datadog.api_key}}"
      site: "{{consumers.datadog.site}}"
{{/if}}
{{#if consumers.dynatrace.enabled}}
  otlphttp/dynatrace:
    endpoint: "{{consumers.dynatrace.endpoint}}"
    headers:
      Authorization: "Api-Token {{consumers.dynatrace.api_token}}"
{{/if}}

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

service:
  extensions: [health_check]
  telemetry:
    metrics:
      level: detailed
      readers:
        - pull:
            exporter:
              prometheus:
                host: "0.0.0.0"
                port: 8888
  pipelines:
    traces:
      receivers: [otlp]
      processors: [transform/boomi_numeric, transform/boomi_usf_fields, batch]
      exporters: [opensearch/traces{{#if consumers.splunk.enabled}}, splunk_hec/splunk{{/if}}{{#if consumers.newrelic.enabled}}, otlp/newrelic{{/if}}{{#if consumers.datadog.enabled}}, datadog/datadog{{/if}}{{#if consumers.dynatrace.enabled}}, otlphttp/dynatrace{{/if}}]
