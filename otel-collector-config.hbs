receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
    timeout: 10s
    send_batch_size: 1024

exporters:
  elasticsearch/logs:                                                                                                                                                         
    endpoints: ["{{consumers.opensearch.endpoint}}"]                                                                                                                        
    logs_index: boomi-logs                          
    user: "{{consumers.opensearch.username}}"
    password: "{{consumers.opensearch.password}}"
    tls:                                                                                                                                                                      
      insecure_skip_verify: true
    sending_queue:                                                                                                                                                            
      enabled: true                                                                                                                                                         
  elasticsearch/metrics:                                                                                                                                                      
    endpoints: ["{{consumers.opensearch.endpoint}}"]
    logs_index: boomi-metrics                                                                                                                                                 
    user: "{{consumers.opensearch.username}}"                                                                                                                               
    password: "{{consumers.opensearch.password}}"
    tls:                                         
      insecure_skip_verify: true                                                                                                                                              
    sending_queue:              
      enabled: true                                                                                                                                                           
  opensearch/traces:                                                                                                                                                        
    http:           
      endpoint: "{{consumers.opensearch.endpoint}}"
      timeout: 30s                                 
      headers:                                                                                                                                                                
        Authorization: "Basic {{consumers.opensearch.auth_header}}"
      tls:                                                                                                                                                                    
        insecure_skip_verify: true                                                                                                                                          
    logs_index: boomi-traces
    sending_queue:                                                                                                                                                            
      enabled: true
{{#if consumers.splunk.enabled}}
  splunk_hec/splunk:
    token: "{{consumers.splunk.token}}"
    endpoint: "{{consumers.splunk.endpoint}}"
    source: boomi
    sourcetype: _json
{{/if}}
{{#if consumers.newrelic.enabled}}
  otlp/newrelic:
    endpoint: https://otlp.nr-data.net:4317
    headers:
      api-key: "{{consumers.newrelic.license_key}}"
{{/if}}
{{#if consumers.datadog.enabled}}
  datadog/datadog:
    api:
      key: "{{consumers.datadog.api_key}}"
      site: "{{consumers.datadog.site}}"
{{/if}}
{{#if consumers.dynatrace.enabled}}
  otlp/dynatrace:
    endpoint: "{{consumers.dynatrace.endpoint}}"
    headers:
      Authorization: "Api-Token {{consumers.dynatrace.api_token}}"
{{/if}}
{{#if consumers.prometheus.enabled}}
  prometheusremotewrite/prometheus:
    endpoint: "{{consumers.prometheus.endpoint}}"
{{/if}}

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

service:
  extensions: [health_check]
  telemetry:
    metrics:
      level: detailed
      readers:
        - pull:
            exporter:
              prometheus:
                host: "0.0.0.0"
                port: 8888
  pipelines:
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [elasticsearch/logs{{#if consumers.splunk.enabled}}, splunk_hec/splunk{{/if}}{{#if consumers.newrelic.enabled}}, otlp/newrelic{{/if}}{{#if consumers.datadog.enabled}}, datadog/datadog{{/if}}{{#if consumers.dynatrace.enabled}}, otlp/dynatrace{{/if}}]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [elasticsearch/metrics{{#if consumers.splunk.enabled}}, splunk_hec/splunk{{/if}}{{#if consumers.newrelic.enabled}}, otlp/newrelic{{/if}}{{#if consumers.datadog.enabled}}, datadog/datadog{{/if}}{{#if consumers.dynatrace.enabled}}, otlp/dynatrace{{/if}}{{#if consumers.prometheus.enabled}}, prometheusremotewrite/prometheus{{/if}}]
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [opensearch/traces{{#if consumers.splunk.enabled}}, splunk_hec/splunk{{/if}}{{#if consumers.newrelic.enabled}}, otlp/newrelic{{/if}}{{#if consumers.datadog.enabled}}, datadog/datadog{{/if}}{{#if consumers.dynatrace.enabled}}, otlp/dynatrace{{/if}}]
